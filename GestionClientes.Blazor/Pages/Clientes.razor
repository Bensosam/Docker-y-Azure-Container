@page "/clientes"
@inject ClienteService ClienteService

<PageTitle>Clientes</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Clientes</h1>
        <p class="text-muted mb-0">Administracion de clientes mediante API REST.</p>
    </div>
    <button class="btn btn-primary" @onclick="NuevoCliente">
        Nuevo Cliente
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <div class="alert @(esError ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
        @mensaje
        <button type="button" class="btn-close" @onclick="LimpiarMensaje"></button>
    </div>
}

@if (cargando)
{
    <div class="text-center py-5">
        <div class="spinner-border" role="status"></div>
        <p class="mt-2">Cargando clientes...</p>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body">
            @if (clientes.Count == 0)
            {
                <div class="alert alert-info mb-0">
                    No hay clientes registrados.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>CUI</th>
                                <th>NIT</th>
                                <th>Nombres</th>
                                <th>Apellidos</th>
                                <th>Direccion</th>
                                <th>Telefono</th>
                                <th>Fecha nacimiento</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cliente in clientes)
                            {
                                <tr>
                                    <td>@cliente.Id_cliente</td>
                                    <td>@cliente.CUI</td>
                                    <td>@cliente.NIT</td>
                                    <td>@cliente.Nombres</td>
                                    <td>@cliente.Apellidos</td>
                                    <td>@cliente.Direccion</td>
                                    <td>@cliente.Telefono</td>
                                    <td>@cliente.Fecha_Nacimiento.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <button class="btn btn-sm btn-warning me-1"
                                                @onclick="() => EditarCliente(cliente)">
                                            Editar
                                        </button>
                                        <button class="btn btn-sm btn-danger"
                                                @onclick="() => EliminarCliente(cliente)">
                                            Eliminar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@if (mostrarModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @(editando ? "Editar Cliente" : "Nuevo Cliente")
                    </h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>

                <EditForm Model="@clienteActual" OnValidSubmit="GuardarCliente">
                    <DataAnnotationsValidator />

                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">CUI</label>
                                <InputText class="form-control" @bind-Value="clienteActual.CUI" />
                                <ValidationMessage For="@(() => clienteActual.CUI)" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">NIT</label>
                                <InputText class="form-control" @bind-Value="clienteActual.NIT" />
                                <ValidationMessage For="@(() => clienteActual.NIT)" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Nombres</label>
                                <InputText class="form-control" @bind-Value="clienteActual.Nombres" />
                                <ValidationMessage For="@(() => clienteActual.Nombres)" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Apellidos</label>
                                <InputText class="form-control" @bind-Value="clienteActual.Apellidos" />
                                <ValidationMessage For="@(() => clienteActual.Apellidos)" />
                            </div>

                            <div class="col-12">
                                <label class="form-label">Direccion</label>
                                <InputText class="form-control" @bind-Value="clienteActual.Direccion" />
                                <ValidationMessage For="@(() => clienteActual.Direccion)" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Telefono</label>
                                <InputText class="form-control" @bind-Value="clienteActual.Telefono" />
                                <ValidationMessage For="@(() => clienteActual.Telefono)" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Fecha de nacimiento</label>
                                <InputDate class="form-control" @bind-Value="clienteActual.Fecha_Nacimiento" />
                                <ValidationMessage For="@(() => clienteActual.Fecha_Nacimiento)" />
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CerrarModal">
                            Cancelar
                        </button>
                        <button type="submit" class="btn btn-primary" disabled="@guardando">
                            @(guardando ? "Guardando..." : "Guardar")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private List<Cliente> clientes = new();
    private Cliente clienteActual = CrearClienteVacio();
    private bool mostrarModal;
    private bool editando;
    private bool cargando = true;
    private bool guardando;
    private string mensaje = string.Empty;
    private bool esError;

    protected override async Task OnInitializedAsync()
    {
        await CargarClientes();
    }

    private async Task CargarClientes()
    {
        try
        {
            cargando = true;
            clientes = await ClienteService.GetClientesAsync();
        }
        catch (Exception ex)
        {
            MostrarError("No se pudo conectar con la API: " + ex.Message);
        }
        finally
        {
            cargando = false;
        }
    }

    private void NuevoCliente()
    {
        clienteActual = CrearClienteVacio();
        editando = false;
        mostrarModal = true;
        LimpiarMensaje();
    }

    private void EditarCliente(Cliente cliente)
    {
        clienteActual = new Cliente
        {
            Id_cliente = cliente.Id_cliente,
            CUI = cliente.CUI,
            NIT = cliente.NIT,
            Nombres = cliente.Nombres,
            Apellidos = cliente.Apellidos,
            Direccion = cliente.Direccion,
            Telefono = cliente.Telefono,
            Fecha_Nacimiento = cliente.Fecha_Nacimiento
        };

        editando = true;
        mostrarModal = true;
        LimpiarMensaje();
    }

    private async Task GuardarCliente()
    {
        try
        {
            guardando = true;
            bool resultado;

            if (editando)
                resultado = await ClienteService.ActualizarClienteAsync(clienteActual);
            else
                resultado = await ClienteService.CrearClienteAsync(clienteActual);

            if (!resultado)
            {
                MostrarError("La API no pudo completar la operacion.");
                return;
            }

            CerrarModal();
            await CargarClientes();
            MostrarExito(editando ? "Cliente actualizado correctamente." : "Cliente registrado correctamente.");
        }
        catch (Exception ex)
        {
            MostrarError("Error al guardar: " + ex.Message);
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task EliminarCliente(Cliente cliente)
    {
        var confirmado = await JSConfirm($"Desea eliminar al cliente {cliente.Nombres} {cliente.Apellidos}?");

        if (!confirmado)
            return;

        try
        {
            var resultado = await ClienteService.EliminarClienteAsync(cliente.Id_cliente);

            if (!resultado)
            {
                MostrarError("No se pudo eliminar el cliente.");
                return;
            }

            await CargarClientes();
            MostrarExito("Cliente eliminado correctamente.");
        }
        catch (Exception ex)
        {
            MostrarError("Error al eliminar: " + ex.Message);
        }
    }

    private void CerrarModal()
    {
        mostrarModal = false;
    }

    private static Cliente CrearClienteVacio()
    {
        return new Cliente
        {
            Fecha_Nacimiento = DateTime.Today
        };
    }

    private void MostrarExito(string texto)
    {
        mensaje = texto;
        esError = false;
    }

    private void MostrarError(string texto)
    {
        mensaje = texto;
        esError = true;
    }

    private void LimpiarMensaje()
    {
        mensaje = string.Empty;
    }

    [Inject]
    private IJSRuntime JS { get; set; } = default!;

    private async Task<bool> JSConfirm(string texto)
    {
        return await JS.InvokeAsync<bool>("confirm", texto);
    }
}
